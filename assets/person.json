{
    "@context": "http://www.schema.org",
    "@type": "Person",
    "@id": "{{ .Site.BaseURL }}",
    "name": "{{ .Site.Params.author }}",
    "url": "{{ .Site.BaseURL }}",
    "description": "{{ .Site.Params.Description }}",

    {{ with .Site.Params.Feat.structuredDataFromGithub }}
    {{ with (resources.GetRemote (print "https://api.github.com/users/" .) | transform.Unmarshal) }}
        "image": "{{ .avatar_url }}",
        {{ if ne .login .Site.Params.author }}
        "alternateName": "{{ .login }}",
        {{ end }}
        {{ with .email }}
        "email": "{{ . }}",
        {{ end }}
        {{ with .location }}
        "address": "{{ . }}",
        {{ end }}
        "affiliation": [
            {{ $count := 0 }}
            {{ $orgs := (resources.GetRemote .organizations_url | transform.Unmarshal) }}
            {{ range $key, $val := $orgs }}
            {{ $count = add $count 1 }}

            {{ with (resources.GetRemote .url | transform.Unmarshal) }}
            {
                "@type": "Organization",
                "name": "{{ .name }}",
                "sameAs": [
                    "{{ .blog }}",
                    "{{ .html_url }}"
                ]
            }{{ if lt $count (len $orgs) }},{{ end}}
        {{- end }}

        ],
        {{- end }}
    {{ end }}
    {{ end }}

    "sameAs": [
        {{ $count := 0 }}
        {{ range $key, $val := .Site.Params.Social -}}
        {{ $count = add $count 1 }}
        "{{ $val }}"{{ if lt $count (len $.Site.Params.Social) }},{{ end}}
        {{- end }}
    ]
}
