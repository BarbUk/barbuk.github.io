{{ $base := dict
    "@context" "http://www.schema.org"
    "@type" "Person"
    "@id" .Site.BaseURL
    "name" (.Site.Params.author)
    "url" .Site.BaseURL
    "description" .Site.Params.Description }}
{{ with .Site.Params.Feat.structuredDataGitHubUser }}
    {{ with (resources.GetRemote (print "https://api.github.com/users/" .) | transform.Unmarshal) }}
        {{ $github := dict
            "image" .avatar_url
            "address" .location }}
        {{ if ne .login .Site.Params.author }}
        {{ $github = merge (dict "alternateName" .login) $github }}
        {{ end }}

        {{ $affiliation := slice }}
        {{ with (resources.GetRemote .organizations_url | transform.Unmarshal) }}
            {{ range $i, $org := . -}}
                {{ with (resources.GetRemote .url | transform.Unmarshal) }}
                    {{ $org := dict
                        "@type" "Organization"
                        "name" (.name)
                        "sameAs" (slice .blog .html_url) }}
                    {{ $affiliation = append $org $affiliation }}
                {{ end }}
            {{- end }}
        {{- end }}
        {{ $github = merge (dict "affiliation" $affiliation) $github }}
        {{ $base = merge $github $base }}
    {{ end }}
{{ end }}
{{ $sameAs := slice }}
{{ range $i, $url := .Site.Params.Social -}}
    {{ $sameAs = append . $sameAs }}
{{- end }}
{{ $base = merge (dict "sameAs" $sameAs) $base }}
{{ jsonify $base }}
